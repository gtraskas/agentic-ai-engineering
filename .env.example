# OpenRouter API key (openrouter.ai/keys) — any LLM through one API
OPENROUTER_API_KEY=

# Optional: override the default chat model (google/gemini-3.1-flash-lite)
OPENROUTER_MODEL=

# Optional: override the job-fit model (defaults to the chat model)
JOBFIT_MODEL=

# Optional: reasoning effort for thinking models (default: low)
ASKGEORGE_REASONING=

# Optional: agent backend ('sdk' default = OpenAI Agents SDK, or 'scratch')
AGENT_BACKEND=

# Optional: set to 0 to disable Qdrant RAG and use full-context mode
ASKGEORGE_RAG=

# Optional: set to 0 to disable the input guardrail (on by default)
ASKGEORGE_GUARDRAIL=

# Optional: Google Calendar booking-page link (enables the embedded calendar)
CALENDAR_BOOKING_URL=

# Optional: Gmail SMTP notifications — AskGeorge leads/unknown questions and
# the crewai/stock_picker decision email.
# Create an App Password: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: OpenAI API key (platform.openai.com/api-keys).
# Needed for the openai_agents_sdk notebook (calls OpenAI directly so run
# traces appear at platform.openai.com/traces) and for the crewai/ crews
OPENAI_API_KEY=

# Optional: Serper API key (serper.dev, free tier) — enables live web search
# in crews that support it, e.g. crewai/financial_researcher
SERPER_API_KEY=
